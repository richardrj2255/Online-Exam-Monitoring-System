/* =====================================================================
   Online Exam Monitoring System - Modern Dual-Theme Design System
   Reference: AI Online Exam Management Dashboard
   Themes: Light (Default) and Dark (Executive Mode)
   Managed dynamically via ui/theme_manager.py
   ===================================================================== */

/* Light Theme Tokens */
/*
   Main Background Canvas: Soft Off-White (#F8FAFC)
   Card Containers & Panels: Pure White (#FFFFFF), 1px solid #E2E8F0, hover: #818CF8
   Primary Accent: Deep Indigo / Royal Blue (#4F46E5 / #4338CA)
   Headings & Body: #0F172A, Secondary: #64748B, Muted: #94A3B8
   Status Badges: Normal (#DCFCE7 bg, #15803D text), Alert (#FFE4E6 bg, #BE123C text)
*/

/* Dark Theme Tokens */
/*
   Main Background Canvas: Deep Slate (#0F172A)
   Card Containers & Panels: #1E293B, 1px solid #334155, hover: #818CF8
   Primary Accent: Vibrant Indigo (#6366F1 / #4F46E5)
   Headings & Body: #F8FAFC, Secondary: #94A3B8, Muted: #64748B
   Status Badges: Normal (#064E3B bg, #34D399 text), Alert (#881337 bg, #FDA4AF text)
*/

QMainWindow, QDialog, QWidget#centralWidget, QWidget#pageWidget, QWidget#rootWidget {
    font-family: "Segoe UI", "Inter", "Roboto", -apple-system, sans-serif;
    font-size: 13px;
}

QFrame#card, QFrame.card, QGroupBox {
    border-radius: 12px;
    padding: 16px;
}

QPushButton {
    border-radius: 8px;
    padding: 9px 18px;
    font-weight: 600;
    font-size: 13px;
}

QTableWidget, QTableView {
    border-radius: 10px;
    font-size: 13px;
    outline: none;
}

QTableWidget::item {
    padding: 9px 12px;
}
